# Banco de dados PostgreSQL (Neon, Supabase, Railway ou Postgres local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/agendamentoon?schema=public"

# URL pública usada nos links de confirmação, e-mails e compartilhamentos
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp de suporte público, com DDI e DDD, somente números.
# Exemplo: 5561999999999. Deixe vazio para ocultar os botões de suporte.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# E-mail transacional (opcional). Sem RESEND_API_KEY, os e-mails vão para o log.
RESEND_API_KEY=""
EMAIL_FROM="AgendamentoON <nao-responda@agendix.app>"

# Segredo HMAC do webhook POST /api/webhooks/payments.
# Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=""

# Pagar.me (Core API v5).
# Sem estas chaves o checkout fica bloqueado e nenhuma assinatura é criada.
PAGARME_SECRET_KEY=""
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=""
# Segredo do webhook POST /api/webhooks/pagarme.
PAGARME_WEBHOOK_SECRET=""

# Atalho de desenvolvimento para liberar o painel sem cobrança.
# Nunca use "true" em produção.
PAYMENTS_DEV_BYPASS="false"

# Segredo do cron GET/POST /api/cron/reminders.
# Gere com: openssl rand -hex 32
CRON_SECRET=""

# Credenciais criadas/atualizadas pelo seed de demonstração.
# Defina senhas fortes no .env.local antes de rodar o seed (mínimo 8 caracteres).
SEED_ADMIN_EMAIL="admin@agendix.app"
SEED_ADMIN_PASSWORD=""
SEED_OWNER_PASSWORD=""
SEED_PROFESSIONAL_PASSWORD=""

# Cria o superadmin e o estabelecimento de teste Studio Aurora.
# Use "true" apenas em ambientes de demonstração.
SEED_EXTRA_DEMO="false"
